{
  "expo": {
    "name": "Krishi Setu",
    "slug": "krishi-setu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/krishisetu-logo.png",
    "scheme": "krishisetu",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/krishisetu-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.krishisetu.app"
    },
    "android": {
      "package": "com.krishisetu.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/krishisetu-logo.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/krishisetu-logo.png"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font"
    ]
  }
}
