# Agro-Cloud AI Engine Environment Variables

# Hugging Face Free Inference API Token
# Instructions:
# 1. Sign up for a free account at https://huggingface.co
# 2. Go to Settings -> Access Tokens (https://huggingface.co/settings/tokens)
# 3. Create a new token with "read" role
# 4. Paste your token below:
HF_TOKEN=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

# Primary Hugging Face Plant Disease Classification Model
# Uses public pretrained model: linkanjarad/mobilenet_v2_1.0_224-plant-disease-identification
HF_MODEL_ID=linkanjarad/mobilenet_v2_1.0_224-plant-disease-identification

# AI Engine Service Config
AI_SERVICE_NAME=Agro-Cloud AI & ML Engine
AI_SERVICE_PORT=8500
APP_ENV=development
LOG_LEVEL=info
