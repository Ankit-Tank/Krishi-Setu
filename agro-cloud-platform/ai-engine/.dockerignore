# Krishi Setu AI-engine Docker build context

# Git
.git
.gitignore
.gitattributes

# Python cache / environments
__pycache__/
*.py[cod]
*.pyo
*.pyd
*$py.class
.venv/
venv/
env/
ENV/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

